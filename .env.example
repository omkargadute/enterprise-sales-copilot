# Copy to credentials.env and fill in values, then:
#   modal secret create sales-copilot --from-dotenv credentials.env --force

DEEPGRAM_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=

# PRISMtrace — ingest auth uses header X-PRISMtrace-Key (not Authorization Bearer)
PRISMTRACE_API_KEY=
PRISMTRACE_PROJECT_ID=
# Public alias: https://prism.blockconvey.com — this project uses the Railway host below
PRISMTRACE_HOST=https://prism-api-prod.up.railway.app

# Optional: pin CORS to your production frontend after first deploy
# FRONTEND_URL=https://your-app.vercel.app
# CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000
